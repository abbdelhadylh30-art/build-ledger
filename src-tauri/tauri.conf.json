{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Build Ledger",
  "version": "1.0.0",
  "identifier": "com.buildledger.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Build Ledger",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Project tracker",
    "longDescription": "Local-first app for tracking the projects you build, what AI you used, and where they're stored.",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
