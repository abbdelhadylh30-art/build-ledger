{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stackmint Studio",
  "version": "1.2.0",
  "identifier": "com.stackmint.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Stackmint Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Business",
    "shortDescription": "Portfolio & launcher",
    "longDescription": "Stackmint Studio — AI-assisted app development portfolio. Three apps shipped. Custom builds available.",
    "windows": {
      "wix": { "language": "en-US" }
    }
  }
}
